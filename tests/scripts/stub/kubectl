#!/bin/bash

echo "$*" >>"$WORK_DIR/calls"

args=" $* "
pod=""
container=""
previous=false
while [ $# -gt 0 ]; do
    case "$1" in
        api-* | hasura-* | redis-*) pod="$1" ;;
        -c)
            container="$2"
            shift
            ;;
        --previous) previous=true ;;
    esac
    shift
done

case "$args" in
    *" get crd helmcharts.helm.cattle.io "* | *" apply --server-side "*) ;;
    *" apply -f - "*) cat >"$WORK_DIR/applied" ;;
    *" get service traefik "*) if [ -f "$WORK_DIR/traefik-address" ]; then cat "$WORK_DIR/traefik-address"; fi ;;
    *" get helmchart "*) echo 1 ;;
    *" get gateway traefik-gateway "*) [ -f "$WORK_DIR/shared-gateway" ] || exit 1 ;;
    *" get httproute "*)
        route="$(printf '%s' "$args" | sed -n 's/.* get httproute \([^ ]*\).*/\1/p')"
        [ -f "$WORK_DIR/route-$route" ] || exit 1
        cat "$WORK_DIR/route-$route"
        ;;
    *" get customresourcedefinitions,"*) if [ -f "$WORK_DIR/cluster-objects" ]; then cat "$WORK_DIR/cluster-objects"; fi ;;
    *" get helmcharts.helm.cattle.io "*)
        name="$(printf '%s' "$args" | sed -n 's/.*metadata\.name=\([^ ]*\).*/\1/p')"
        if [ -f "$WORK_DIR/helmcharts-$name" ]; then cat "$WORK_DIR/helmcharts-$name"; fi
        ;;
    *" get secrets "*)
        name="$(printf '%s' "$args" | sed -n 's/.*owner=helm,name=\([^ ]*\).*/\1/p')"
        if [ -f "$WORK_DIR/releases-$name" ]; then cat "$WORK_DIR/releases-$name"; fi
        ;;
    *" get job helm-install-"*)
        case "$args" in
            *'uid}{"|"}'*)
                if [ -f "$WORK_DIR/job-states" ]; then
                    head -n 1 "$WORK_DIR/job-states"
                    if [ "$(wc -l <"$WORK_DIR/job-states")" -gt 1 ]; then
                        sed -i.bak 1d "$WORK_DIR/job-states"
                    fi
                elif [ -f "$WORK_DIR/job-retried" ]; then
                    echo "uid-2|True|"
                elif [ -f "$WORK_DIR/job-failed" ]; then
                    echo "uid-1||True"
                else
                    echo "uid-1|True|"
                fi
                ;;
            *'type=="Failed"'*) if [ -f "$WORK_DIR/job-failed" ]; then echo True; fi ;;
            *) echo uid-1 ;;
        esac
        ;;
    *" logs job/helm-install-"*)
        if [ ! -f "$WORK_DIR/job-logs" ]; then
            echo "error: timed out waiting for the condition" >&2
            exit 1
        fi
        cat "$WORK_DIR/job-logs"
        ;;
    *" logs -n kube-system -l batch.kubernetes.io/controller-uid="*) if [ -f "$WORK_DIR/pod-logs" ]; then cat "$WORK_DIR/pod-logs"; fi ;;
    *" patch helmchart "* | *" delete job helm-install-"*) touch "$WORK_DIR/job-retried" ;;
    *" get service ingress-nginx-controller "*)
        case "$args" in
            *'name=="https"'*) port_file="$WORK_DIR/nginx-https-port" ;;
            *) port_file="$WORK_DIR/nginx-http-port" ;;
        esac
        if [ ! -f "$port_file" ]; then
            echo 'Error from server (NotFound): services "ingress-nginx-controller" not found' >&2
            exit 1
        fi
        cat "$port_file"
        ;;
    *" get nodes "*)
        if [ -f "$WORK_DIR/nodes" ]; then cat "$WORK_DIR/nodes"; fi
        if [ -f "$WORK_DIR/nodes.next" ]; then mv "$WORK_DIR/nodes.next" "$WORK_DIR/nodes"; fi
        ;;
    *" annotate "*) if [ -f "$WORK_DIR/annotate-fails" ]; then exit 1; fi ;;
    *" label "*) ;;
    *" get pods "*) cat "$WORK_DIR/pods" ;;
    *" get pod "*) cat "$WORK_DIR/containers-$pod" ;;
    *" logs "*)
        if [ "$previous" = true ]; then
            echo "previous logs of $pod/$container"
        else
            echo "current logs of $pod/$container"
        fi
        ;;
    *" get events "*)
        if [ -f "$WORK_DIR/events-error" ]; then
            echo "The connection to the server was refused" >&2
            exit 1
        fi
        echo "Normal Killing pod/hasura-1 Container hasura failed startup probe, will be restarted"
        ;;
esac
