S3_BUCKET=5stack
S3_DB_BACKUP_BUCKET=5stack-db-backups

# example: console.example.com
S3_CONSOLE_HOST=

S3_ENDPOINT=
S3_USE_SSL=
S3_PORT=

# Only for a remote bucket. The region has to match the one the endpoint
# expects (Backblaze: us-east-005 and friends) -- SigV4 signs it into the
# credential scope, and a mismatch is rejected. Defaults to us-east-1.
S3_REGION=

# Set to false only for real AWS S3, which dropped path-style addressing for
# buckets created after Sept 2020. Every other implementation accepts it.
S3_FORCE_PATH_STYLE=
