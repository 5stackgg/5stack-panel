# TURN relay for voice and video calls.
#
# Optional. Leave TURN_DOMAIN blank and no relay is offered at all: calls fall
# back to STUN, which is enough for most players. Set it to run a relay for the
# ones it is not enough for -- anyone behind carrier-grade NAT (every mobile
# network) or on a network that blocks UDP outright.
#
# Deliberately NOT used for regional matchmaking latency probes or for game
# streams; see web/composables/useIceServers.ts for why.

# example: turn.5stack.gg
# Must resolve to this node, with 3478/udp, 3478/tcp and the relay port range
# below reachable from the internet.
TURN_DOMAIN=

# The address coturn advertises to clients. Normally left blank -- it is
# resolved from TURN_DOMAIN. Set it by hand if that record is proxied by a CDN
# (Cloudflare's orange cloud, say): the proxy answers with its own address,
# which coturn would then hand out as a relay candidate nobody can reach. TURN
# is not HTTP and cannot go through such a proxy at all, so the record should be
# DNS-only in the first place.
TURN_PUBLIC_IP=

# What coturn calls itself when challenging a client. Only has to match what the
# API signs credentials for, which it does automatically. Defaults to
# TURN_DOMAIN when blank.
TURN_REALM=

# One port per concurrent relayed session, so this range is also the cap on how
# many there can be. Narrowed from coturn's 49152-65535 default so the firewall
# rule stays one line -- the same reasoning that pinned MediaMTX to a single UDP
# port. Widen it if you actually run out.
TURN_MIN_PORT=50000
TURN_MAX_PORT=50200
