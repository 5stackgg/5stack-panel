# The passwords of MediaMTX's users, generated on install.
#   api: the panel api, on MediaMTX's API and metrics
#   streamer: game streamers, publishing match streams
#   relay: the api, publishing and reading voice and cameras
#   viewer: browsers watching a match stream, through Traefik
MEDIAMTX_API_PASSWORD=$(RAND32)
MEDIAMTX_STREAMER_PASSWORD=$(RAND32)
MEDIAMTX_RELAY_PASSWORD=$(RAND32)
MEDIAMTX_VIEWER_PASSWORD=$(RAND32)
