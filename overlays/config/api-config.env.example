# Each domain must be unique for routing purposes

# example: 5stack.gg
WEB_DOMAIN=

# example: ws.5stack.gg
WS_DOMAIN=

# example: api.5stack.gg
API_DOMAIN=

# example: tv.5stack.gg
RELAY_DOMAIN=

# example: demos.5stack.gg
DEMOS_DOMAIN=

# example: hls.5stack.gg
GAME_STREAM_DOMAIN=

# Set by ./backblaze-proxy.sh. example: cf.5stack.gg
CLOUDFLARE_WORKER_DOMAIN=

# example: hello@example.com
MAIL_FROM=

# Other origins that may use the api and Hasura signed in, comma separated,
# scheme and all. example: https://dev.5stack.gg
EXTRA_CORS_ORIGINS=

TAILSCALE_NODE_IP=

TAILSCALE_NET_NAME=

TAILSCALE_CLIENT_ID=
