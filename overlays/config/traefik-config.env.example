# The ports the node serves HTTP and HTTPS on. Change them only when 80/443
# are already taken on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# Behind your own reverse proxy (nginx, Nginx Proxy Manager, HAProxy, ...) every
# request reaches the panel from the proxy's address, so the panel can't tell
# visitors apart and 5Stack can't see this server's public address. List the
# address the proxy connects from (or a range, separated by commas) and the
# panel believes its X-Forwarded-For instead. Only ever your own proxy: anyone
# listed here can claim to be any visitor. Run ./update.sh after changing it.
TRUSTED_PROXIES=
