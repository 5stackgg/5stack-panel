#!/usr/bin/env python3
import json
import os
import re
import sys
import urllib.parse

work = os.environ["WORK_DIR"]
state_path = os.path.join(work, "cf-state.json")
state = json.load(open(state_path))
args = sys.argv[1:]

method, data, url, out_null, write_out, from_stdin = "GET", None, None, False, None, False
dump_headers, resolve = False, None
forms = {}
i = 0
while i < len(args):
    a = args[i]
    if a == "-X":
        method = args[i + 1]
        i += 1
    elif a in ("--data-binary", "--data", "-d"):
        data = args[i + 1]
        i += 1
    elif a == "-o":
        out_null = args[i + 1] == "/dev/null"
        i += 1
    elif a == "-w":
        write_out = args[i + 1]
        i += 1
    elif a == "-K":
        from_stdin = args[i + 1] == "-"
        i += 1
    elif a == "-D":
        dump_headers = args[i + 1] == "-"
        i += 1
    elif a == "--resolve":
        resolve = args[i + 1].rsplit(":", 1)[1]
        i += 1
    elif a == "-F":
        name, _, value = args[i + 1].partition("=")
        value = value.split(";type=")[0]
        if value[:1] in ("<", "@"):
            value = open(value[1:]).read()
        forms[name] = value
        i += 1
    elif a in ("-H", "--max-time"):
        if a == "-H" and "authorization" in args[i + 1].lower():
            open(os.path.join(work, "cf-calls"), "a").write("TOKEN-IN-ARGS\n")
        i += 1
    elif not a.startswith("-"):
        url = a
    i += 1

auth = sys.stdin.read() if from_stdin else ""


def log(line):
    with open(os.path.join(work, "cf-calls"), "a") as f:
        f.write(line + "\n")


def save():
    json.dump(state, open(state_path, "w"))


def reply(result=None, success=True, errors=None, code=None):
    body = {"success": success, "errors": errors or [], "result": result}
    if code is not None:
        body["errors"] = [{"code": code, "message": "not found"}]
    sys.stdout.write(json.dumps(body))
    sys.exit(0)


EDGE = "104.21.0.1"


def proxied(host):
    return any(r["name"] == host and r.get("proxied") and r["type"] == "A" for r in state.get("records", []))


def zone_of(host):
    for z in state.get("zones", []):
        if host == z["name"] or host.endswith("." + z["name"]):
            return z["id"]
    return None


def rule_matches(expr, host, path):
    hosts = re.search(r"http\.host in \{([^}]*)\}", expr)
    if hosts and host not in re.findall(r'"([^"]+)"', hosts.group(1)):
        return False
    for neg, prefix in re.findall(r'(not )?starts_with\(http\.request\.uri\.path, "([^"]+)"\)', expr):
        if bool(neg) == path.startswith(prefix):
            return False
    return True


def page_rule_matches(target, host):
    if target.startswith("https://"):
        return False
    pattern = target.split("://", 1)[-1].split("/", 1)[0]
    return re.fullmatch(re.escape(pattern).replace("\\*", ".*"), host) is not None


def answer(code, headers):
    if dump_headers:
        sys.stdout.write("HTTP/1.1 %d X\r\n" % code)
        for k, v in headers.items():
            sys.stdout.write("%s: %s\r\n" % (k, v))
        sys.stdout.write("\r\n")
    if write_out:
        sys.stdout.write(str(code))
    sys.exit(0)


def plain_http(host, path):
    through = proxied(host) and (resolve == EDGE or (resolve is None and not state.get("stale_dns")))
    log("HTTP %s%s%s" % (host, path, " cloudflare" if through else ""))
    edge = {"server": "cloudflare", "cf-ray": "8f00-AMS"}
    https = {"location": "https://%s%s" % (host, path)}
    if through:
        zone = zone_of(host)
        if state.get("settings", {}).get(zone, {}).get("always_use_https") == "on":
            answer(301, dict(edge, **https))
        for pr in state.get("pagerules", {}).get(zone, []):
            ids = [a["id"] for a in pr.get("actions", [])]
            if pr.get("status", "active") == "active" and ("always_use_https" in ids or "forwarding_url" in ids) and page_rule_matches(pr["targets"][0]["constraint"]["value"], host):
                answer(301, dict(edge, **https))
        for rule in state.get("rulesets", {}).get(zone, {}).get("http_request_dynamic_redirect", {}).get("rules", []):
            if rule.get("enabled", True) and rule.get("action") == "redirect" and rule_matches(rule["expression"], host, path):
                answer(rule["action_parameters"]["from_value"]["status_code"], dict(edge, **https))
        if host in state.get("challenge", []):
            answer(403, dict(edge, **{"cf-mitigated": "challenge"}))
        code = state.get("origin", {}).get(host, 200)
        if code >= 520:
            answer(code, edge)
    else:
        edge = {}
    if path == "/.well-known/acme-challenge/5stack-check" and not state.get("no_acme_route"):
        answer(404, dict(edge, **{"x-5stack-check": "acme-path"}))
    answer(308, dict(edge, **https))


if url.startswith("https://1.1.1.1/cdn-cgi/trace"):
    sys.stdout.write("fl=1\nip=%s\nts=1\n" % state.get("ip", "203.0.113.40"))
    sys.exit(0)

if url.startswith("https://1.1.1.1/dns-query"):
    name = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)["name"][0]
    ip = EDGE if proxied(name) and not state.get("stale_dns") else state.get("ip", "203.0.113.40")
    sys.stdout.write(json.dumps({"Status": 0, "Answer": [{"name": name, "type": 1, "data": ip}]}))
    sys.exit(0)

if url.startswith("http://"):
    parsed = urllib.parse.urlparse(url)
    plain_http(parsed.hostname, parsed.path or "/")

parsed = urllib.parse.urlparse(url)
if not parsed.path.startswith("/client/v4"):
    log("ORIGIN %s%s" % (parsed.hostname, parsed.path if parsed.path not in ("", "/") else ""))
    if parsed.path == "/health":
        worker = next((r["script"] for z in state.get("routes", {}).values() for r in z
                       if r["pattern"] == parsed.hostname + "/*" and state.get("workers", {}).get(r["script"])), None)
        proxied = any(r["name"] == parsed.hostname and r.get("proxied") for r in state.get("records", []))
        if worker and proxied and not state.get("worker_down"):
            sys.stdout.write(json.dumps({"ok": True, "worker": worker}, separators=(",", ":")))
            sys.exit(0)
        sys.exit(22)
    code = state.get("origin", {}).get(parsed.hostname, 200)
    if write_out:
        sys.stdout.write(str(code))
    sys.exit(0)

if "Bearer %s" % state.get("token", "") not in auth:
    reply(None, False, [{"code": 9109, "message": "Invalid access token"}])

path = parsed.path[len("/client/v4"):]
query = urllib.parse.parse_qs(parsed.query)
log("%s %s%s" % (method, path, (" " + data) if data else ""))
parts = path.strip("/").split("/")
zones = state.setdefault("zones", [])
records = state.setdefault("records", [])

if parts == ["zones"]:
    name = query.get("name", [""])[0]
    reply([z for z in zones if z["name"] == name])
if parts == ["user", "tokens", "verify"]:
    reply({"status": "active"})
if parts[:1] == ["accounts"] and parts[2:4] == ["workers", "scripts"] and method == "PUT":
    if state.get("no_workers_write"):
        reply(None, False, [{"code": 10000, "message": "Authentication error"}])
    state.setdefault("workers", {})[parts[4]] = {"account": parts[1], "metadata": json.loads(forms["metadata"]), "module": forms.get("worker.js", "")}
    save()
    reply({"id": parts[4]})
if parts[0] != "zones":
    reply(None, False, [{"code": 7003, "message": "no route"}])
zone = parts[1]
rest = parts[2:]
if rest == [] and method == "GET":
    reply({"id": zone, "account": {"id": "acct1"}})

if rest[:1] == ["dns_records"]:
    if method == "GET":
        out = [r for r in records if r["zone"] == zone]
        if "name" in query:
            out = [r for r in out if r["name"] == query["name"][0]]
        if "type" in query:
            out = [r for r in out if r["type"] == query["type"][0]]
        reply(out)
    if method == "POST":
        body = json.loads(data)
        if body["type"] == "TXT" and state.get("no_dns_edit"):
            reply(None, False, [{"code": 10000, "message": "Authentication error"}])
        state["next"] = state.get("next", 0) + 1
        body.update({"id": "r%d" % state["next"], "zone": zone, "modified_on": "2026-11-03T12:00:00Z"})
        records.append(body)
        save()
        reply(body)
    rid = rest[1]
    rec = next((r for r in records if r["id"] == rid), None)
    if rec is None:
        reply(None, False, [{"code": 81044, "message": "record not found"}])
    if method == "DELETE":
        records.remove(rec)
        save()
        reply({"id": rid})
    if method in ("PATCH", "PUT"):
        rec.update(json.loads(data))
        save()
        reply(rec)

if rest == ["ssl", "certificate_packs"]:
    reply(state.get("packs", {}).get(zone, []))
if rest[:2] == ["workers", "routes"]:
    if state.get("no_routes_read"):
        reply(None, False, [{"code": 10000, "message": "Authentication error"}])
    routes = state.setdefault("routes", {}).setdefault(zone, [])
    if method == "POST":
        body = json.loads(data)
        state["next"] = state.get("next", 0) + 1
        body["id"] = "route%d" % state["next"]
        routes.append(body)
        save()
        reply(body)
    if method == "PUT":
        body = json.loads(data)
        for j, r in enumerate(routes):
            if r["id"] == rest[2]:
                body["id"] = r["id"]
                routes[j] = body
        save()
        reply(body)
    reply(routes)
if rest[:1] == ["settings"]:
    settings = state.setdefault("settings", {}).setdefault(zone, {})
    if method == "PATCH":
        settings[rest[1]] = json.loads(data)["value"]
        save()
    reply({"id": rest[1], "value": settings.get(rest[1], "off" if rest[1] == "always_use_https" else "on")})
if rest == ["pagerules"]:
    if state.get("no_pagerules_read"):
        reply(None, False, [{"code": 10000, "message": "Authentication error"}])
    reply(state.get("pagerules", {}).get(zone, []))
if rest == ["bot_management"]:
    reply({"fight_mode": state.get("bot_fight", {}).get(zone, False)})
if rest == ["ssl", "universal", "settings"]:
    reply({"enabled": True})
if rest == ["argo", "tiered_caching"]:
    argo = state.setdefault("argo", {})
    if method == "PATCH":
        argo[zone] = json.loads(data)["value"]
        save()
    reply({"value": argo.get(zone, "off")})
if rest == ["cache", "tiered_cache_smart_topology_enable"]:
    tiered = state.setdefault("tiered", {})
    if method == "PATCH":
        tiered[zone] = json.loads(data)["value"]
        save()
    reply({"value": tiered.get(zone, "off")})

rulesets = state.setdefault("rulesets", {}).setdefault(zone, {})
if rest[:2] == ["rulesets", "phases"]:
    phase = rest[2]
    if phase == "http_request_dynamic_redirect" and state.get("no_redirect_rules"):
        reply(None, False, [{"code": 10000, "message": "Authentication error"}])
    if method == "GET":
        if phase not in rulesets:
            reply(None, False, code=10003)
        reply(rulesets[phase])
    if method == "PUT":
        if phase in rulesets:
            log("PUT-OVER-EXISTING %s" % phase)
        state["next"] = state.get("next", 0) + 1
        rs = {"id": "rs%d" % state["next"], "phase": phase, "rules": []}
        for rule in json.loads(data)["rules"]:
            state["next"] += 1
            rule["id"] = "rule%d" % state["next"]
            rs["rules"].append(rule)
        rulesets[phase] = rs
        save()
        reply(rs)
if rest[:1] == ["rulesets"]:
    rs = next((r for r in rulesets.values() if r["id"] == rest[1]), None)
    rule = json.loads(data)
    if method == "POST":
        state["next"] = state.get("next", 0) + 1
        rule["id"] = "rule%d" % state["next"]
        rs["rules"].append(rule)
    if method == "PATCH":
        for j, r in enumerate(rs["rules"]):
            if r["id"] == rest[3]:
                rule["id"] = r["id"]
                rs["rules"][j] = rule
    save()
    reply(rs)

reply(None, False, [{"code": 7003, "message": "no route for %s" % path}])
